# Conexão do banco — Supabase (Postgres).
# Pegue em: Supabase > Project Settings > Database > Connection string > URI
# Use a porta do POOLER (6543) para serverless, ou 5432 para conexão direta.
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEU_REF.supabase.co:5432/postgres?sslmode=require

# Origens liberadas no CORS (separadas por vírgula). Em produção, a URL do
# frontend na Vercel. Em dev pode deixar "*".
CORS_ORIGINS=*
