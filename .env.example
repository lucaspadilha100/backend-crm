# Conexão do banco — Supabase (Postgres) via CONNECTION POOLER (IPv4).
# IMPORTANTE: use a string do "Session pooler" (ou Transaction pooler), NÃO a
# "Direct connection" — a direta é IPv6-only e falha na Vercel.
# Pegue em: Supabase > Connect > Session pooler.
DATABASE_URL=postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-SUA_REGIAO.pooler.supabase.com:5432/postgres?sslmode=require

# Origens liberadas no CORS (separadas por vírgula). Em produção, a URL do
# frontend na Vercel. Em dev pode deixar "*".
CORS_ORIGINS=*
